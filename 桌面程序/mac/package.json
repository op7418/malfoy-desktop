{
  "name": "miss-malfoy-desktop",
  "productName": "Miss Malfoy",
  "version": "0.1.0",
  "description": "AI 女友桌面 · 马尔福小姐（即梦 AI 短剧工作室 Demo）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "sync": "rm -rf web && cp -R ../app web",
    "start": "npm run sync && electron .",
    "dist": "npm run sync && electron-builder --mac dmg --arm64"
  },
  "build": {
    "appId": "demo.missmalfoy.desktop",
    "productName": "Miss Malfoy",
    "asar": false,
    "files": ["main.js", "preload.js", "web/**/*"],
    "mac": { "category": "public.app-category.entertainment", "target": ["dmg"], "identity": null, "extendInfo": { "LSUIElement": true } },
    "dmg": { "title": "Miss Malfoy" },
    "directories": { "output": "dist" }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
